# Your Aiminaabee backend, should be updated to where you are hosting your server. Remember to update CORS settings for your server. See – https://docs.aiminaabeejs.com/learn/configurations/aiminaabee-config#httpstorecors
AIMINAABEE_BACKEND_URL=http://localhost:3000

# Your publishable key that can be attached to sales channels. See - https://docs.aiminaabeejs.com/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_AIMINAABEE_PUBLISHABLE_KEY=pk_test

# Your store URL, should be updated to where you are hosting your storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Your preferred default region. When middleware cannot determine the user region from the "x-vercel-country" header, the default region will be used. ISO-2 lowercase format. 
NEXT_PUBLIC_DEFAULT_REGION=us

# Store code for API requests. Kept in env, not in the URL.
NEXT_PUBLIC_DEFAULT_STORE_CODE=

# Your Stripe public key. See – https://docs.aiminaabeejs.com/resources/commerce-modules/payment/payment-provider/stripe
NEXT_PUBLIC_STRIPE_KEY=

# Your Next.js revalidation secret. See – https://nextjs.org/docs/app/building-your-application/data-fetching/fetching-caching-and-revalidating#on-demand-revalidation
REVALIDATE_SECRET=supersecret
